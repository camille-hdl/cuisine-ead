    "report-dir": "playwright-coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "ajv@<=6.12.6": "6.15.0",
    "js-yaml@4.1.0": "4.3.2",
    "js-yaml@4.1.1": "4.3.2",
    "nyc": "$nyc",
    "serialize-javascript": "7.1.1",
