{
  "name": "cuisine-ead",
  "version": "1.7.0",
  "description": "",
  "main": "public/index.html",
  "scripts": {
    "test": "run-s jest build:dev e2e",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "build": "run-s buildrollup workbox",
    "build:dev": "run-s buildrollup:dev workbox",
    "buildrollup": "rollup -c --configProd --configMini",
    "buildrollup:dev": "rollup -c",
    "workbox": "workbox injectManifest workbox-config-esm.js",
    "workbox:generate": "workbox generateSW workbox-config-esm.js",
    "watch": "rollup -c -w",
    "serve": "serve -l 5000",
    "jest": "jest",
    "lint": "eslint .",
    "deploy": "npm run build",
    "prettier": "prettier --write src/**/*.{js,jsx}",
    "flow": "flow",
    "pretest": "rm -rf .nyc_output || true",
    "posttest": "npm run report:combined",
    "mkdir:reports": "mkdir reports || true",
    "precopy:reports": "npm run mkdir:reports",
    "copy:reports": "cp jest-coverage/coverage-final.json reports/from-jest.json && (cp playwright-coverage/coverage-final.json reports/from-playwright.json || true)",
    "precombine:reports": "npm run copy:reports && mkdir .nyc_output || true",
    "combine:reports": "nyc merge reports && mv coverage.json .nyc_output/out.json",
    "prereport:combined": "npm run combine:reports",
    "report:combined": "nyc report --reporter lcov --reporter text --report-dir coverage"
  },
  "devDependencies": {
    "@babel/cli": "^7.14.8",
    "@babel/core": "^7.14.8",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.27.1",
    "@babel/plugin-transform-optional-chaining": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.14.2",
    "@babel/preset-env": "^7.14.2",
    "@babel/preset-flow": "^7.13.13",
    "@babel/preset-modules": "^0.1.4",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "babel-jest": "^28.1.1",
    "babel-plugin-istanbul": "^6.0.0",
    "babel-plugin-transform-imports": "^2.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "flow-bin": "^0.156.0",
    "globals": "^16.4.0",
    "hermes-eslint": "^0.32.0",
    "jest": "^28.1.1",
    "npm-run-all2": "^8.0.4",
    "nyc": "^18.0.0",
    "prettier": "^2.8.8",
    "rollup": "^4.63.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "serve": "^14.2.0",
    "workbox-cli": "^7.4.1"
  },
  "dependencies": {
    "@babel/preset-react": "^7.18.6",
    "@babel/runtime": "^7.14.0",
    "@material-ui/core": "^4.11.4",
    "file-saver": "^2.0.5",
    "immutable": "^4.0.0-rc.12",
    "jschardet": "^3.0.0",
    "jszip": "^3.6.0",
    "papaparse": "^5.3.0",
    "ramda": "^0.27.1",
    "react": "^18.2.0",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-redux": "^8.0.5",
    "react-router-dom": "^7.18.3",
    "react-use": "^17.4.0",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2",
    "reselect": "^4.0.0",
    "workbox-window": "^7.4.1",
    "xml-parser-xo": "^2",
    "xxhash-wasm": "^0.4.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camille-hdl/ead-tinker.git"
  },
  "keywords": [
    "ead",
    "xml-ead"
  ],
  "author": "Camille Hodoul <camille.hodoul@gmail.com> (http://twitter.com/Eartz_HC)",
  "license": "SEE LICENCE IN LICENCE",
